-- [ฟังก์ชัน 5: มองเห็นทุกคน (ESP / Highlight)]
local espEnabled = false
local function UpdateESP()
	for _, player in pairs(Players:GetPlayers()) do
		if player ~= LocalPlayer and player.Character then
			local highlight = player.Character:FindFirstChild("HackerESP")
			if espEnabled then
				if not highlight then
					highlight = Instance.new("Highlight")
					highlight.Name = "HackerESP"
					highlight.FillColor = Color3.fromRGB(0, 255, 80)
					highlight.OutlineColor = Color3.fromRGB(0, 100, 30)
					highlight.FillTransparency = 0.5
					highlight.OutlineTransparency = 0
					highlight.Parent = player.Character
				end
			else
				if highlight then
					highlight:Destroy()
				end
			end
		end
	end
end

CreateToggleButton("ESPBtn", "มองเห็นทุกคน (ESP)", function(state)
	espEnabled = state
	UpdateESP()
end)

Players.PlayerAdded:Connect(function(player)
	player.CharacterAdded:Connect(function()
		task.wait(0.5)
		if espEnabled then UpdateESP() end
	end)
end)

-- [ฟังก์ชัน 6: กดปุ่มค้างให้เป็นทีเดียว (Auto-Click / Key Hold Hold Trigger)]
local holdAutoEnabled = false
CreateToggleButton("AutoClickBtn", "กดปุ่มค้างอัตโนมัติ", function(state)
	holdAutoEnabled = state
end)

local isHolding = false
UserInputService.InputBegan:Connect(function(input, gameProcessed)
	if gameProcessed or not holdAutoEnabled then return end
	if input.UserInputType == Enum.UserInputType.MouseButton1 then
		isHolding = true
		task.spawn(function()
			while isHolding and holdAutoEnabled do
				if LocalPlayer.Character and LocalPlayer.Character:FindFirstChildOfClass("Tool") then
					LocalPlayer.Character:FindFirstChildOfClass("Tool"):Activate()
				end
				task.wait(0.1)
			end
		end)
	end
end)

UserInputService.InputEnded:Connect(function(input)
	if input.UserInputType == Enum.UserInputType.MouseButton1 then
		isHolding = false
	end
end)

