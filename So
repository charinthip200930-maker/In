-- ฟังก์ชั่นสร้างปุ่มกดเปิด/ปิดสไตล์แฮกเกอร์
local function CreateToggleButton(name, text, callback)
	local Btn = Instance.new("TextButton")
	Btn.Name = name
	Btn.Text = text .. "\n[ ปิด ]"
	Btn.BackgroundColor3 = Color3.fromRGB(15, 35, 20)
	Btn.TextColor3 = Color3.fromRGB(180, 180, 180)
	Btn.Font = Enum.Font.GothamSemibold
	Btn.TextSize = 12
	Btn.Parent = ContentFrame

	local BtnCorner = Instance.new("UICorner")
	BtnCorner.CornerRadius = UDim.new(0, 6)
	BtnCorner.Parent = Btn

	local BtnStroke = Instance.new("UIStroke")
	BtnStroke.Color = Color3.fromRGB(0, 80, 30)
	BtnStroke.Thickness = 1
	BtnStroke.Parent = Btn

	local enabled = false
	Btn.MouseButton1Click:Connect(function()
		enabled = not enabled
		if enabled then
			Btn.BackgroundColor3 = Color3.fromRGB(0, 70, 30)
			Btn.TextColor3 = Color3.fromRGB(0, 255, 120)
			BtnStroke.Color = Color3.fromRGB(0, 200, 80)
			Btn.Text = text .. "\n[ เปิด ]"
		else
			Btn.BackgroundColor3 = Color3.fromRGB(15, 35, 20)
			Btn.TextColor3 = Color3.fromRGB(180, 180, 180)
			BtnStroke.Color = Color3.fromRGB(0, 80, 30)
			Btn.Text = text .. "\n[ ปิด ]"
		end
		callback(enabled)
	end)
	return Btn
end

